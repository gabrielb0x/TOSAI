# Exemple de configuration TOSAI (backend/.env)
# Ce fichier est prioritaire sur backend/config/.env.

# Environnement applicatif: local | prod
APP_ENV=local

# Port HTTP du backend (par défaut 9000 pour un reverse proxy NGINX)
APP_PORT=9000

# URL PostgreSQL utilisee par le backend (optionnelle pour le mode API-only local)
DATABASE_URL=

# Variables optionnelles utilisees par `make db-init` / `backend/scripts/init_db.sh`
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tosai
DB_USER=tosai_app
DB_PASSWORD=change-me
DB_SSLMODE=disable

# URL admin PostgreSQL optionnelle si vous ne voulez pas passer par `sudo -u postgres`
POSTGRES_ADMIN_URL=

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,https://tosai.fr,https://www.tosai.fr

# Proxies de confiance pour recuperer la vraie IP client (utile pour le rate limit)
TRUSTED_PROXIES=127.0.0.1,::1

# (Optionnel) Jeton admin pour protéger les endpoints sensibles
ADMIN_API_TOKEN=super-cle-secrete

# Cle OpenAI requise pour /v1/summary
OPENAI_API_KEY=sk-xxxx

# Modele OpenAI principal pour l'analyse finale
OPENAI_MODEL=gpt-5.4-mini

# Modele OpenAI optionnel pour la phase de web research
OPENAI_RESEARCH_MODEL=gpt-5.4-mini

# Base URL OpenAI (utile pour un proxy/self-host)
OPENAI_BASE_URL=https://api.openai.com/v1

# Timeout HTTP global (fetch URL + appel OpenAI), en secondes
HTTP_TIMEOUT_SECONDS=45

# Taille max du texte envoyé à OpenAI (en caractères)
ANALYSIS_INPUT_MAX_CHARS=12000

# Age max du cache d'analyse avant de forcer is_contestable=true
ANALYSIS_CACHE_MAX_AGE_DAYS=90

# Rate limit local par IP
ANALYSIS_RATE_LIMIT_PER_MINUTE=1

# Si true, l'API renvoie un gros bloc debug dans ses responses JSON
API_DEBUG_MODE=false
