# Backend configuration for local (non-Docker) runs.
# Copy this file to .env and adjust values to match your setup.

# Port where the Gin server listens.
PORT=8080

# PostgreSQL connection string. The server will run migrations automatically at startup.
DATABASE_URL=postgres://autotos:autotos@localhost:5432/autotos?sslmode=disable

# Optional: API key for future OpenAI integrations.
OPENAI_API_KEY=

# Password for admin-only endpoints (to be used in later milestones).
ADMIN_PASSWORD=changeme

# CORS configuration: use * for local testing or a specific origin for production.
ALLOWED_ORIGINS=http://localhost:5173
