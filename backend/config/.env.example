# Copiez plutôt backend/.env.example à la racine du dossier backend si possible.
# Ce fichier reste utilisable en fallback (backend/config/.env) pour les anciens workflows.

APP_ENV=local
APP_PORT=9000
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tosai
DB_USER=tosai_app
DB_PASSWORD=change-me
DB_SSLMODE=disable
POSTGRES_ADMIN_URL=
CORS_ORIGINS=http://localhost:5173,https://tosai.fr,https://www.tosai.fr
TRUSTED_PROXIES=127.0.0.1,::1
ADMIN_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
HTTP_TIMEOUT_SECONDS=45
ANALYSIS_INPUT_MAX_CHARS=12000
ANALYSIS_CACHE_MAX_AGE_DAYS=90
ANALYSIS_RATE_LIMIT_PER_MINUTE=1
API_DEBUG_MODE=false
